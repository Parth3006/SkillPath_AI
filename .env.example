# SkillPath AI – Environment Variables
# -------------------------------------
# Copy this file to .env and fill in your actual API key.
# NEVER commit the .env file to GitHub (it's already in .gitignore).
#
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model (default: gemini-3.5-flash)
# Other options: gemini-3.5-flash-lite, gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash
